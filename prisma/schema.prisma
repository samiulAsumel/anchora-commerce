generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(CUSTOMER)
  stores       Store[]
  orders       Order[]
  refreshTokens RefreshToken[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Store {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  owner       User         @relation(fields: [ownerId], references: [id])
  ownerId     String
  products    Product[]
  collections Collection[]
  orders      Order[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([ownerId])
}

model Collection {
  id        String    @id @default(uuid())
  name      String
  slug      String
  store     Store     @relation(fields: [storeId], references: [id])
  storeId   String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

model Product {
  id            String       @id @default(uuid())
  name          String
  slug          String
  description   String
  priceCents    Int
  currency      String       @default("USD")
  inventory     Int          @default(0)
  imageUrl      String?
  store         Store        @relation(fields: [storeId], references: [id])
  storeId       String
  collections   Collection[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@unique([storeId, slug])
  @@index([storeId])
}

model Cart {
  id        String     @id @default(uuid())
  token     String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cart      Cart    @relation(fields: [cartId], references: [id])
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id           String      @id @default(uuid())
  store        Store       @relation(fields: [storeId], references: [id])
  storeId      String
  customer     User        @relation(fields: [customerId], references: [id])
  customerId   String
  status       OrderStatus @default(PENDING)
  totalCents   Int
  currency     String      @default("USD")
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([storeId])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id              String  @id @default(uuid())
  order           Order   @relation(fields: [orderId], references: [id])
  orderId         String
  product         Product @relation(fields: [productId], references: [id])
  productId       String
  quantity        Int
  unitPriceCents  Int
  nameSnapshot    String

  @@index([orderId])
  @@index([productId])
}
